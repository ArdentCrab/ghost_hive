{
  "status": "implemented",
  "hudVersion": "v3-ultra-max-super-comfort",
  "titlePrefixStays": "[GHv2]",
  "buildGate": "v3 HUD in watch_hud.cpp + hud_preview.ts. make test then make eboot.",
  "law": {
    "noNewModule": true,
    "noNewPspState": true,
    "noNewEvent": true,
    "noNewPolicy": true,
    "noInventedMetrics": true,
    "ramOnly": true,
    "hmacINeverDown": true,
    "note": "Nur Zeilen kombinieren / SDK-Zeilen streichen. Keine neuen Device-Felder."
  },
  "meta": {
    "raster": {
      "cols": 48,
      "rows": 24,
      "glyph": "9x11",
      "ascii": "0x20-0x7E"
    },
    "absentLiteral": "--",
    "modes": {
      "Watch": "vier Seiten, Live-RAM",
      "Down": "Ghost-Engine, Watch bleibt, STATE:Down, Eintritt Kernel-Seite",
      "Black": "komplett leer, nur O zurück, Pipeline weiter"
    }
  },
  "chrome": {
    "titlePattern": "[GHv2] PAGE:<Hive|Kernel|Net|Peer> STATE:<Watch|Down>",
    "titlePad": 48,
    "separator": "------------------------------------------------",
    "separatorLen": 48,
    "pages": [
      "Hive",
      "Kernel",
      "Net",
      "Peer"
    ],
    "states": [
      "Watch",
      "Down"
    ]
  },
  "removedFromHud": {
    "reason": "PSP-SDK-Theater, kein Hive-Signal",
    "labels": [
      "PSP",
      "Clock",
      "Battery",
      "WLAN"
    ]
  },
  "forbiddenNeverOnHud": [
    "HMAC-Hex payload[88..127]",
    "TelemetryMagic 0x42",
    "peer.bind 112 Bytes",
    "vaultPerPeer",
    "ackBudgetPerSec as raw constant line",
    "telemRateSec",
    "heartbeatIntervalSec",
    "heartbeatMissLimit",
    "scanBuffer",
    "Policy-IDs P01-P16",
    "Policy-Names",
    "Pipeline-Results",
    "Capability-Bit-Namen (nur hex in Caps)",
    "Severity enum",
    "Permissions enum"
  ],
  "v3": {
    "hive": {
      "goal": "Roster-Intelligenz: HB+Drop sichtbar; Census ok/pend/blk + hive-wide hbmiss/drop; Alert+Last eine Zeile",
      "lines": [
        {
          "label": "Hive",
          "values": [
            "empty",
            "danger",
            "down",
            "block",
            "warn",
            "pend",
            "ok"
          ]
        },
        {
          "label": "Peers",
          "was": "n/32 on= pend= blk= sil=",
          "now": "n/32 ok= pend= blk= hbmiss= drop=",
          "okMeans": "DeviceState Online count (rename on→ok)"
        },
        {
          "label": "Roles",
          "pattern": "W{n} P{n} S{n} R{n} N{n} M{n}"
        },
        {
          "label": "Alert",
          "was": "down | danger id | block id | hmac-i | vault-safe | --",
          "now": "same first token + last={evShort} {id<=8}",
          "example": "danger 3 last=Mine 3",
          "ifQuiet": "-- last=Telem W or -- last=--"
        },
        {
          "label": "HMAC-I",
          "kind": "uint count"
        },
        {
          "label": "Ack",
          "kind": "pending ACK uint"
        },
        {
          "label": "HBMiss",
          "kind": "sum miss_count"
        },
        {
          "label": "Time",
          "pattern": "YYYY-MM-DD HH:MM UTC"
        },
        {
          "label": "roster",
          "was": "id role st age=N",
          "now": "id roleTag st age=N hb=X drop=Y",
          "maxRows": 11,
          "overflow": "+N",
          "clip": 48
        }
      ],
      "droppedStandaloneLast": "Last-Zeile entfällt; Inhalt in Alert last="
    },
    "kernel": {
      "goal": "Ghost-Flags, kein SDK; kombinierte Down/Vault/Bind",
      "keep": [
        "IBSS",
        "Radio",
        "Kernel",
        "Arming",
        "Vault",
        "Safe",
        "Keys",
        "Auth",
        "Bind",
        "Down",
        "Phase",
        "Snap",
        "Flush",
        "Kill",
        "Policy",
        "Peek",
        "HMAC-I"
      ],
      "combined": [
        {
          "label": "Down",
          "pattern": "{view} {phase} kill={yes|no} danger={on|off}",
          "example": "active freeze kill=no danger=off"
        },
        {
          "label": "Vault",
          "pattern": "{n}/64 safe={yes|no}",
          "example": "3/64 safe=yes"
        },
        {
          "label": "Bind",
          "pattern": "{yes|no} auth={yes|no} keys={yes|no}",
          "example": "yes auth=yes keys=yes"
        }
      ],
      "stillOwnLines": [
        "IBSS",
        "Radio",
        "Kernel",
        "Arming",
        "Snap",
        "Flush",
        "Policy",
        "Peek",
        "HMAC-I"
      ]
    },
    "net": {
      "goal": "Scanner + Anti-Hack + Minen maximale Dichte",
      "keep": [
        "UDP",
        "Pin",
        "ReplayW",
        "AckBd",
        "IP",
        "Scan",
        "Twin",
        "XAP",
        "Ap1",
        "Ap2",
        "Mines",
        "Replay",
        "Alerts",
        "Drift",
        "WorkerSync",
        "HBMiss",
        "Last",
        "Time",
        "IBSS"
      ],
      "combined": [
        {
          "label": "Ap1",
          "pattern": "{ssid} r={rssi} ch={ch} {enc} twin={yes|no}",
          "twinPerAp": "yes if this AP ssid is GHSTHIVE AND hive ssid count>=2"
        },
        {
          "label": "Ap2",
          "pattern": "same as Ap1"
        },
        {
          "label": "Replay",
          "pattern": "{tracked}/64 blk={yes|no} mines={n}",
          "example": "12/64 blk=yes mines=3"
        },
        {
          "label": "Sync",
          "was": "Drift + WorkerSync two lines",
          "pattern": "drift={+|-}Ns|{--} worker={trust>=2|--}",
          "example": "drift=+2s worker=trust>=2"
        }
      ],
      "droppedStandalone": [
        "Mines as own line if folded into Replay",
        "Drift own line",
        "WorkerSync own line"
      ]
    },
    "peer": {
      "goal": "Anti-Hack + Komfort-Telemetrie; sechs Messzeilen → eine Telem-Zeile",
      "keep": [
        "idx",
        "DevN",
        "Status",
        "Trust",
        "Last",
        "Age",
        "Cap",
        "Tag",
        "HB",
        "Drop",
        "RAM",
        "CPU",
        "GPU",
        "Traffic",
        "Battery",
        "WiFi"
      ],
      "combined": [
        {
          "label": "State",
          "was": "Status + Trust + HB",
          "pattern": "{peerStatus} trust={0-3} hb={n|--}",
          "example": "ok trust=3 hb=0"
        },
        {
          "label": "Caps",
          "was": "Cap + Tag",
          "pattern": "{hhhh} tag={hh}",
          "example": "0003 tag=0a"
        },
        {
          "label": "Telem",
          "was": "RAM CPU GPU Traffic Battery WiFi",
          "pattern": "ram={n|--} cpu={n|--} gpu={n|--} n={kbps|--} b={pct|--} w={mbit|--}",
          "example": "ram=512 cpu=12 gpu=-- n=0 b=88 w=54",
          "clip": 48,
          "nMeans": "traffic_kbps",
          "bMeans": "battery_percent",
          "wMeans": "wifi_mbit"
        }
      ],
      "stillOwnLines": [
        "DevN id= role=",
        "Last",
        "Age",
        "Drop",
        "idx"
      ],
      "empty": "idx: 0/0 only"
    },
    "kernelDown": {
      "goal": "Down-Engine Transparenz, kombinierte Engine+Replay/Ack",
      "keep": [
        "Arming",
        "Vault",
        "Down",
        "Phase",
        "Snap",
        "Flush",
        "Kill",
        "Policy",
        "Timer",
        "GameLook",
        "Danger",
        "Replay",
        "AckBd",
        "Hive",
        "Peers",
        "Alert"
      ],
      "combined": [
        {
          "label": "Down",
          "pattern": "active {phase} kill={yes|no} danger={on|off}",
          "example": "active freeze kill=no danger=off"
        },
        {
          "label": "Replay",
          "pattern": "{tracked} ack={n}/8",
          "example": "12 ack=2/8"
        }
      ],
      "const": {
        "GameLook": "off"
      }
    }
  },
